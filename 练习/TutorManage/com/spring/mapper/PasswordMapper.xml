<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.spring.mapper.PasswordMapper">


	<update id="updateTeacherPassword" parameterType="object">
		update teacher
		set password = MD5(#{password})
		where tno = #{tno}
	</update>

	<update id="updateStudentPassword" parameterType="object">
		update student
		set password = MD5(#{password})
		where sno = #{sno}
	</update>
</mapper>	
